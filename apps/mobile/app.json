{
  "expo": {
    "name": "NightGuide",
    "slug": "nightguide",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/nightguide-icon.png",
    "scheme": "nightguide",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeffersonfagundess.nightguide"
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/nightguide-adaptive.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jeffersonfagundess.nightguide",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-nightguide-colors",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o NightGuide use a câmera para fotos e leitura de ingressos.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o NightGuide acesse suas fotos para anexar imagens a eventos e publicações.",
          "cameraPermission": "Permitir que o NightGuide tire fotos para eventos e publicações."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o NightGuide use sua localização para mostrar eventos próximos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E2FF54",
          "defaultChannel": "eventos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
